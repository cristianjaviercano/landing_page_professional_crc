# Optional. Enables the "Ask my résumé" assistant (POST /api/ask) and its floating button.
# Without it the button is not rendered. Set a monthly spend limit on this key in the Anthropic Console.
ANTHROPIC_API_KEY=

# Optional model override (default: claude-opus-5-5).
# A much cheaper option for a public Q&A widget:
# ANTHROPIC_MODEL=claude-haiku-5-5
