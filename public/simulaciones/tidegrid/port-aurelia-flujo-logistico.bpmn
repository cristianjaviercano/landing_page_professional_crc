 <bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Port Aurelia — escala de un buque" processRef="Process_1"/></bpmn:collaboration>
 <bpmn:process id="Process_1" isExecutable="false">
  <bpmn:laneSet id="LaneSet_1">
   <bpmn:lane id="Lane_1" name="Buque"><bpmn:flowNodeRef>n1</bpmn:flowNodeRef><bpmn:flowNodeRef>n2</bpmn:flowNodeRef><bpmn:flowNodeRef>n3</bpmn:flowNodeRef><bpmn:flowNodeRef>n4</bpmn:flowNodeRef><bpmn:flowNodeRef>n5</bpmn:flowNodeRef><bpmn:flowNodeRef>n6</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_2" name="Planificación"><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>p1</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_3" name="Muelle (QC)"><bpmn:flowNodeRef>q1</bpmn:flowNodeRef><bpmn:flowNodeRef>q2</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>q3</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef><bpmn:flowNodeRef>q4</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_4" name="Patio (SC + RTG)"><bpmn:flowNodeRef>y1</bpmn:flowNodeRef><bpmn:flowNodeRef>y2</bpmn:flowNodeRef><bpmn:flowNodeRef>y2e</bpmn:flowNodeRef><bpmn:flowNodeRef>y3</bpmn:flowNodeRef><bpmn:flowNodeRef>y4</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_5" name="Puerta y camiones"><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>t3</bpmn:flowNodeRef><bpmn:flowNodeRef>t4</bpmn:flowNodeRef><bpmn:flowNodeRef>t5</bpmn:flowNodeRef><bpmn:flowNodeRef>t6</bpmn:flowNodeRef><bpmn:flowNodeRef>t7</bpmn:flowNodeRef><bpmn:flowNodeRef>t8</bpmn:flowNodeRef></bpmn:lane>
   <bpmn:lane id="Lane_6" name="Ferrocarril"><bpmn:flowNodeRef>r1</bpmn:flowNodeRef><bpmn:flowNodeRef>r2</bpmn:flowNodeRef><bpmn:flowNodeRef>r3</bpmn:flowNodeRef><bpmn:flowNodeRef>r4</bpmn:flowNodeRef><bpmn:flowNodeRef>r5</bpmn:flowNodeRef><bpmn:flowNodeRef>r6</bpmn:flowNodeRef></bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="n1" name="ETA anunciada"/>
  <bpmn:task id="n2" name="Navegar al fondeadero"/>
  <bpmn:task id="n3" name="Esperar en fondeadero"/>
  <bpmn:exclusiveGateway id="g1" name="¿Atraque libre?"/>
  <bpmn:task id="p1" name="Asignar atraque (auto ≥ 7 min o clic)"/>
  <bpmn:task id="n4" name="Maniobrar y atracar"/>
  <bpmn:task id="q1" name="Amarre y verificación (5 min)"/>
  <bpmn:task id="q2" name="Descargar contenedor (QC, 2 min)"/>
  <bpmn:exclusiveGateway id="g2" name="¿Quedan por descargar?"/>
  <bpmn:task id="q3" name="Cargar contenedor (QC, 2 min)"/>
  <bpmn:exclusiveGateway id="g3" name="¿Quedan por cargar?"/>
  <bpmn:task id="q4" name="Largar amarras (3 min)"/>
  <bpmn:task id="n5" name="Zarpar"/>
  <bpmn:endEvent id="n6" name="Escala completada"/>
  <bpmn:task id="y1" name="Transportar a bloque (straddle)"/>
  <bpmn:task id="y2" name="Apilar hasta 4 de alto (RTG)"/>
  <bpmn:endEvent id="y2e" name="Contenedor en patio"/>
  <bpmn:task id="y3" name="Recuperar del bloque (RTG)"/>
  <bpmn:task id="y4" name="Llevar al muelle (straddle)"/>
  <bpmn:startEvent id="t1" name="Camión llega"/>
  <bpmn:task id="t2" name="Control de puerta (IN)"/>
  <bpmn:task id="t3" name="Rodar al bloque trasero"/>
  <bpmn:exclusiveGateway id="t4" name="¿Entrega o recogida?"/>
  <bpmn:task id="t5" name="Entregar contenedor"/>
  <bpmn:task id="t6" name="Recoger contenedor"/>
  <bpmn:task id="t7" name="Control de puerta (OUT)"/>
  <bpmn:endEvent id="t8" name="Camión sale"/>
  <bpmn:startEvent id="r1" name="Tren anunciado"/>
  <bpmn:task id="r2" name="Entrar por túnel y posicionar"/>
  <bpmn:task id="r3" name="Cargar vagón (RMG, 2 min)"/>
  <bpmn:exclusiveGateway id="r4" name="¿Tren completo (12 cajas)?"/>
  <bpmn:task id="r5" name="Mantener 2 min y partir"/>
  <bpmn:endEvent id="r6" name="Tren despachado"/>
